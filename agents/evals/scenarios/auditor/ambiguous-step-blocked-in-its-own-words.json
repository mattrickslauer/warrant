          "index": 1,
          "title": "Check the pads before you touch anything",
          "explanation": "If they are already past the limit the rest of the job changes.",
          "fields": [
            {
              "key": "pad_thickness",
              "kind": "measurement",
              "acceptance_rule": "within",
              "acceptance_min": 2,
