rules_version = '2';

// Warrant — tenancy, enforced by Firestore itself.
//
// This file is the second half of a rule written twice. The first half is `tenantFromClaims`
// in web/src/auth/tenant.ts, and the two MUST agree; scripts/rules.test.mjs feeds the same
// table of claims to both and fails if they disagree. See docs/data-model.md §7 and
// specs/2026-08-20-firestore-design.md §2.
//
// What this protects: every authenticated client — the browser holding a real ID token, and
// the Android client — reads and writes through these rules. Server code using the Admin SDK
// bypasses them entirely, which is why the server takes its tenant only from a verified
// session cookie (web/src/auth/session.ts) and never from a request.
//
// THE ONE THING TO KNOW BEFORE EDITING THIS FILE: rules are OR'd and there is no deny. If any
// `allow` grants access, access is granted, and a narrower rule written afterwards cannot take
// it back. Every protection below is therefore expressed at the point access is granted, never
// as a later exception.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Identity ----------------------------------------------------------------------
    //
    // A Workspace domain is an enterprise. A consumer account is a tenant of one. A visitor
    // who has not signed in is a tenant of one that has not been claimed.
    //
    // `hd` is a custom claim written by the server after it verified Google's own ID token —
    // Firebase does not propagate Google's hd by itself. See web/src/auth/google-hd.ts.

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function hd() {
      return signedIn() && 'hd' in request.auth.token && request.auth.token.hd != null
        ? request.auth.token.hd
        : null;
    }

    function tenantOf() {
      return hd() != null
        ? hd()
        : (isAnonymous() ? 'anon:' + request.auth.uid : 'u:' + request.auth.uid);
    }

    function inTenant(t) {
      return signedIn() && tenantOf() == t;
    }

    // --- What a client may not write ---------------------------------------------------

    // Collections a client may READ within its tenant but never WRITE. Each is written by the
    // Admin SDK from a server path that holds standing the client does not have.
    //
    // This list is the security boundary of the whole instance space. Adding a collection to
    // it is cheap; noticing later that one is missing is not.
    //
    //   members            role and standing decide who may waive a step. A technician able to
    //                      write this could promote themselves and waive their own work.
    //   records            "written once by the Seal, never updated" is only true if a client
    //                      cannot update it.
    //   decisions          the agent reasoning a public record quotes. Forgeable = worthless.
    //   readings           tool_id is the only thing separating a measured number from a typed
    //                      one. This is the collection the whole product rests on.
    //   procedure_versions a frozen version a running job is pinned to, and the point at which
    //                      may_publish_procedures standing is enforced.
    //
    // NOTE these are all FIRST-SEGMENT collections under the tenant, and that is not a
    // stylistic choice. A `{document=**}` wildcard binds only the first segment, so a
    // collection nested inside another (/components/{id}/readings/{id}) binds to the OUTER
    // name and silently escapes this list. Anything that must be write-protected has to sit
    // directly under /tenants/{t}/. See specs/2026-08-20-firestore-design.md §14.5.
    function serverWritten(collection) {
      // `findings` and `audits` join the list for the same reason `decisions` is on it: they
      // are what an agent concluded, and a conclusion the subject of it can edit is not a
      // finding. A shop that could delete "this step is ambiguous" would delete it.
      return collection in ['members', 'records', 'decisions', 'readings', 'procedure_versions',
                            'findings', 'audits'];
    }

    // Claims a client may never make for itself, at any depth in the tenant subtree.
    //
    // Provenance is stamped by the Seal, release by the Gate, and attestation by Play
    // Integrity server-side. A client asserting any of them is asserting the conclusion the
    // system exists to reach independently.
    //
    // `tool_id` is only reachable here because a Field is now its own document. Inside the
    // old steps[].fields[] array no rule could see it — rules cannot inspect array contents.
    //
    // This is defence in depth, NOT the primary control. A rule can only refuse what a client
    // sends. The Seal recomputes every field's class from the server-written `readings`
    // collection and never trusts what arrived on the field document.
    // Every clause asks "is this client SETTING it", never "is it set" — for the merge reason
    // spelled out in `changing()` below, which had been applied to the step-settling clauses
    // and not to these. The difference is not academic: a MERGE write presents the whole
    // post-merge document, so once the Seal stamped `provenance_class` or the ingest route
    // stamped `tool_id`, the absolute form refused every subsequent client write to that
    // document — a technician could not re-capture a field an instrument had touched. The
    // protection is unchanged, because a client cannot set these values and cannot change one
    // the server set; what it may now do is leave them alone.
    function clientMayNotClaim() {
      return !(request.resource.data.get('provenance_class', '') == 'measured'
               && changing('provenance_class'))
          && !(request.resource.data.get('capture_surface', '') == 'app_instrument'
               && changing('capture_surface'))
          && !(request.resource.data.get('status', '') == 'sealed' && changing('status'))
          && !changing('tool_id')
          && !changing('attestation_play_integrity')
          && !changing('attestation_device_id')
          && !changing('armor_verdict')
          // `adjudicated` is the sweep's flag, and the client MUST be able to write `false` on
          // create — a capture without it is invisible to the net that catches an undecided
          // one. What it may not do is mark its own evidence decided, which would delete that
          // capture from the sweep's query and leave it judged by nobody.
          && !(request.resource.data.get('adjudicated', false) == true
               && changing('adjudicated'))
          // The tier is the ceiling a job SETS OUT to reach, so a client names it at startJob.
          // It may not be raised afterwards, and the Seal recomputes what was actually earned
          // from attestations and readings regardless of what is written here.
          && !(resource != null && changing('tier'))
          // A SEALED JOB IS FINISHED, and nothing a client sends may touch it again.
          //
          // Stated outright rather than left to the clauses above. Until `changing()` was
          // applied to them, `status != 'sealed'` was ABSOLUTE and incidentally refused every
          // write to an already-sealed document; asking instead whether the client is CHANGING
          // the status — which is right, and fixes a real bug where the Seal's own stamp locked
          // a technician out of re-capturing — quietly dropped that side effect. A client could
          // then rewrite a sealed job's contents freely, provided it left `status` alone.
          //
          // web/scripts/audit-adversarial.test.mjs caught it: "provenance_class 'measured'
          // cannot be forged with no instrument" writes a sealed job whose forged class sits
          // inside a steps[] array, where no rule can see it. The Seal recomputes provenance
          // from the server-written `readings` collection and never trusts the document, so the
          // sealed RECORD was never at risk — but a finished job being rewritable at all is not
          // a property worth arguing about, and this is one clause.
          && !(resource != null && resource.data.get('status', '') == 'sealed')
          && clientMayNotSettleAStep()
          && clientSignsOnlyForItself();
    }

    // Did this write change a field, as opposed to leaving what was already there?
    //
    // A MERGE write presents `request.resource.data` as the whole document AFTER the merge, so
    // a naive "this field must be absent" check would refuse a technician adding a blocker
    // reason to a step the fleet had already partly accepted. Comparing against `resource`
    // asks the question that is actually meant: not "is this field set" but "is this client
    // setting it". `resource` is null on a create, where anything present is by definition new.
    function changing(field) {
      return resource == null
          ? request.resource.data.get(field, null) != null
          : request.resource.data.get(field, null) != resource.data.get(field, null);
    }

    // A CLIENT MAY NOT SETTLE A STEP.
    //
    // This is the tick in the box, and it is the whole product. `performed`, `waived` and
    // `impossible` are the three statuses that finish a step, and every one of them is a
    // conclusion the fleet reaches from evidence: `performed` when every required field has
    // been accepted by an Inspector, `waived` only on a named person who holds standing, and
    // `impossible` on a Foreman's disposition. A technician writing any of them directly is an
    // interested party recording their own verdict, which is the exact practice this system
    // exists to replace.
    //
    // Until this existed, `web/scripts/audit-adversarial.test.mjs` could write a `performed`
    // step outcome with no evidence, and a `waived` one naming the CEO, from an ordinary
    // signed-in technician account. That file was not in scripts/smoke.sh, so nothing ran it.
    //
    // `pending` and `deferred` are deliberately still writable. Neither settles anything and
    // neither releases a machine — `deferred` keeps the job open and the machine held, which
    // is the conservative direction, and refusing it would break a technician deferring a step
    // the fleet had already ruled on once.
    //
    // The three server-written fields are compared rather than forbidden, for the merge reason
    // in `changing()` above.
    function clientMayNotSettleAStep() {
      return !(request.resource.data.get('status', '') in ['performed', 'waived', 'impossible']
               && changing('status'))
          && !changing('waived_by')
          && !changing('disposition_action')
          && !changing('accepted_fields');
    }

    // A CLIENT MAY NOT SIGN SOMEBODY ELSE'S NAME.
    //
    // `reason_by` names the person who said a step could not be done, and the Seal reads it
    // straight into the sealed record's `actors` — display name, photograph and role, looked up
    // from `members` (seal.ts, publish.ts). `dispose.ts` reads the same field as the technician
    // a Foreman's disposition concerns, and routes the follow-up task to them.
    //
    // Nothing refused it. `waived_by` on the line above is refused outright, `reason_by` sat
    // beside it unguarded, and an ordinary tenant member could therefore write a COLLEAGUE'S
    // uid and put that colleague's face on an immutable public record beside a sentence they
    // never said. That is the same forgery `waived_by` exists to prevent, on the field next to
    // it.
    //
    // The honest path was broken in the mirror image of the same gap: neither client ever sent
    // a uid at all — the web sent the literal "you" and the phone "technician" — so the member
    // lookup found nobody and every record's `actors` came out empty. Attribution was
    // simultaneously forgeable and absent.
    //
    // So the rule is not "never", which would keep it absent. It is "only for yourself", which
    // is a question rules can answer exactly: `request.auth.uid` is the one identity a client
    // cannot lie about, and it is the same identity the write is already authorised under. The
    // clients now read it from the signed-in user rather than accepting it from a caller, so
    // the value and the permission come from one place and cannot disagree.
    //
    // `finalized_by` is the same field one level up — who declared a job ready for the fleet —
    // and gets the same treatment for the same reason, before something starts reading it.
    function clientSignsOnlyForItself() {
      return (!changing('reason_by')
              || request.resource.data.get('reason_by', null) == request.auth.uid)
          && (!changing('finalized_by')
              || request.resource.data.get('finalized_by', null) == request.auth.uid);
    }

    // --- Type space --------------------------------------------------------------------
    //
    // The catalogue is a published reference: manufacturer specifications, documents and the
    // retrieval corpus. It belongs to nobody's tenant, every signed-in user may read it, and
    // NOBODY may write it from a client. Promotion into the catalogue is a reviewed
    // server-side act (docs/data-model.md §8), so it runs with Admin credentials and does not
    // need a rule here.
    //
    // The invariant that makes this safe is structural: a spec document has no tenant field,
    // so tenant data has nowhere to leak into.

    match /spec_nodes/{id}  { allow read: if signedIn(); allow write: if false; }
    match /spec_values/{id} { allow read: if signedIn(); allow write: if false; }
    match /spec_docs/{id}   { allow read: if signedIn(); allow write: if false; }
    match /spec_chunks/{id} { allow read: if signedIn(); allow write: if false; }

    // --- Published records -------------------------------------------------------------
    //
    // A capability URL. The id is 22 characters of crypto randomness and is NOT derived from
    // the job id, which would be enumerable. Holding the link is the entire credential, which
    // is the point: a customer or an insurer checks a service record without an account.
    //
    // The document here is a REDACTED PROJECTION written by the Seal — no tenant id, no uids,
    // no raw storage refs, no costs. The private record stays under its tenant. Unsharing
    // deletes this document, and because media is proxied rather than signed (§6.3), every
    // image URL dies with it.

    // GET, NOT READ. `read` is `get` + `list`, and a `list` rule that does not depend on the
    // document being fetched is a rule that grants the WHOLE COLLECTION: any client could run
    // getDocs(collection(db, "records")) and walk every record anybody had ever shared. That
    // defeats the paragraph above entirely — an unguessable id buys nothing if the ids do not
    // have to be guessed — and it is the reason `get` and `list` are separable at all.
    //
    // So the capability is honoured only when the holder NAMES the document, which is what
    // holding the link means.
    match /records/{publicId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // --- Public procedures ---------------------------------------------------------------
    //
    // A procedure a shop chose to show the world: the steps, the acceptance rules and the
    // bounds, so somebody else can read what "done" means here and run it themselves.
    //
    // The private procedure never moves. It stays at /tenants/{t}/procedures/{id}, which the
    // subtree rule above keeps unreachable to everyone else, and sharing writes a SECOND
    // document — a projection of ONE frozen version — exactly as sharing a record does.
    //
    // This is why `public_id` on the procedure is a pointer and not a permission. A boolean
    // inside the tenant subtree could not have made anything readable: nothing outside the
    // tenant can see that subtree to read the boolean. What makes a procedure public is the
    // existence of the document below. web/src/server/procedures.ts says the same thing at
    // more length, and it was right before this collection existed.
    //
    // LIST IS ALLOWED HERE, and that is the one line worth arguing about, because ten lines
    // above /records refuses it. The difference is what the id means. A record's public id is
    // a capability — 128 bits of randomness, and holding the link IS the credential, so a
    // `list` rule would hand over every record anyone had ever shared to a client that had
    // been given no link at all. A public procedure is the opposite: being FOUND is the
    // entire point of publishing one, and the browse and search surfaces are a listing of
    // this collection. Enumerable on purpose is not the same failure as enumerable by
    // accident.
    //
    // Which is exactly why the projection carries no tenant id and no uid. The owner is named
    // by a display label, the way a published record names its issuer, and nothing here can
    // be walked back to the tenant that wrote it.
    //
    // Nobody writes it from a client. A world-readable collection a browser may write to is a
    // defacement of every surface that renders it, and the home page renders this one.

    match /public_procedures/{publicId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Per-user secrets ---------------------------------------------------------------
    //
    // OAuth refresh tokens for Google Calendar. Unreachable by ANY client, including the user
    // whose token it is — a browser never needs it, because the sweep writes calendar events
    // server-side.
    //
    // This is a top-level root and not /tenants/{t}/… on purpose. Under the tenant, the
    // recursive read below would hand every colleague the token.

    match /user_secrets/{uid} {
      allow read, write: if false;
    }

    // --- Instrument replay state ---------------------------------------------------------
    //
    // The last counter each paired instrument spent. A signed reading frame is worth exactly
    // one write, and this is what spends it — without it, a frame observed on the air (BLE is
    // broadcast) could be replayed onto a different job for as long as the device lived.
    //
    // A top-level root, NOT /tenants/{t}/…, for the same reason `user_secrets` is one: the
    // recursive read below would otherwise hand every colleague the current counter of every
    // instrument in the shop, and the next counter is precisely the input a forger is missing.
    // Nobody reads or writes it from a client at all; `/api/ingest/reading` holds it under
    // Admin credentials, in a transaction, because "has this frame been used" is a
    // read-then-write on a contended key.

    match /instrument_counters/{id} {
      allow read, write: if false;
    }

    // --- Sweep bookmarks -----------------------------------------------------------------
    //
    // Where each rotating scan in server/tasks.ts got to. Not tenant data — a cursor is a
    // document path in somebody's tenant, so this is precisely the kind of root that must not
    // be readable by a client, and it is server-only machinery besides.

    match /sweep_cursors/{id} {
      allow read, write: if false;
    }

    // --- Instance space ----------------------------------------------------------------

    // The tenant document itself is provisioned server-side on first sign-in. A client may
    // not forge one, because creating `acme.com` before anyone at acme.com had signed in
    // would leave an outsider sitting inside the enterprise when they arrived.
    //
    match /tenants/{t} {
      allow read: if inTenant(t);
      allow write: if false;
    }

    // Everything beneath a tenant, at every depth — jobs and their step outcomes, fields and
    // captures, components, nodes, overrides, procedures, tasks, devices.
    //
    // READ stays broad: a collection added under a tenant tomorrow is readable by its tenant
    // the day it is created rather than the day somebody remembers to write a rule for it.
    // WRITE is narrowed at the point it is granted, because it cannot be narrowed afterwards.
    //
    // NOTE the `{collection}` segment, which is doing real work and is not decoration. A
    // recursive wildcard in rules_version 2 matches ZERO or more segments, so the obvious
    // `match /tenants/{t}/{document=**}` ALSO matches /tenants/{t} itself and silently
    // re-granted the write the rule above refuses — an outsider could seed `acme.com`.
    // Consuming the subcollection name explicitly means the shortest path this rule can
    // match is /tenants/{t}/{collection}, which is a collection and never a write target.
    // web/scripts/rules.test.mjs is what caught this, and is what keeps it caught.
    match /tenants/{t}/{collection}/{document=**} {
      allow read: if inTenant(t);
      // `create, update` rather than `write`, and the split is load-bearing rather than
      // stylistic. `write` covers DELETE, and on a delete `request.resource` is null — so
      // `clientMayNotClaim()` was dereferencing null, erroring, and refusing every delete in
      // the instance. The protection was real but it was an accident, and an accident cannot
      // be reasoned about: nothing here said whether a client was ever meant to delete
      // anything, so nothing said which deletes were the dangerous ones.
      //
      // Naming create and update leaves delete UNGRANTED here and decided on purpose below.
      // Everything not named there — every capture, field and outcome under a sealed job,
      // every document in a collection nobody has thought about yet — stays undeletable by
      // the same default that catches an unwritten rule.
      allow create, update: if inTenant(t) && !serverWritten(collection) && clientMayNotClaim();
    }

    // --- The one destructive act a client gets ------------------------------------------
    //
    // ABANDONING A JOB THAT NEVER SEALED.
    //
    // A shop accumulates half-finished runs: a job started against the wrong machine, a demo,
    // a phone that came out of a pocket mid-procedure. None became evidence, all of them sit
    // in the records list forever, and the job that genuinely wants an answer ends up three
    // screens down. Refusing every delete protects no record — it just makes the list useless,
    // and a list nobody reads is how a waiting question goes unanswered for a week.
    //
    // So the line is drawn AT THE SEAL, which is where every other line in this file is drawn.
    // Before it a job is an attempt and its owner may throw it away. After it the job is
    // finished, and `resource.data.status == 'sealed'` refuses the delete outright — the same
    // clause `clientMayNotClaim()` already uses to refuse rewriting one.
    //
    // Note what is NOT reachable even so: `records` is server-written and untouched by this,
    // so the artifact a stranger was sent a link to survives regardless of what happens to the
    // job it came from. Deleting an unsealed job destroys an attempt, never a record.
    match /tenants/{t}/jobs/{jobId} {
      allow delete: if inTenant(t)
                    && resource != null
                    && resource.data.get('status', '') != 'sealed';
    }

    // The job's own evidence, deletable on exactly the same condition — read off the PARENT,
    // because a step outcome carries its own `status` ('performed', 'pending') and has no idea
    // whether the job above it sealed. Without the `get()` a client could delete the outcomes
    // out from under a sealed job while the header sat there refusing to be touched.
    //
    // This costs one document read per delete. That is the correct price for the question
    // being asked, and a job is abandoned once.
    //
    // Order matters on the client and is documented where it is relied on: subcollections
    // first, header last. Delete the header first and this `get()` finds nothing, every
    // remaining delete is refused, and what is left is orphaned evidence with no row in any
    // list to reach it from.
    match /tenants/{t}/jobs/{jobId}/{sub}/{docId} {
      allow delete: if inTenant(t)
                    && !serverWritten(sub)
                    && get(/databases/$(database)/documents/tenants/$(t)/jobs/$(jobId))
                         .data.get('status', '') != 'sealed';
    }

    // Anything not named above is denied. Stated rather than implied, because a reader
    // should not have to know Firestore's default to know this.
    //
    // This also refuses client COLLECTION GROUP queries. Enabling one requires a rule matching
    // /{path=**}/tasks/{taskId}, and no such rule exists — so the cross-tenant sweep is
    // available to the server, which holds Admin credentials, and structurally unavailable to
    // a browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
