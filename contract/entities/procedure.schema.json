{
  "$id": "procedure",
  "title": "Procedure",
  "type": "object",
  "description": "Compiled from a Scoper conversation. Versioned; a sealed record names the version it ran.",
  "properties": {
    "id":        { "type": "string" },
    "tenant_id": { "type": "string" },
    "key":       { "type": "string", "description": "Stable across versions. e.g. front-brake-service." },
    "title":     { "type": "string" },
    "version":   { "type": "integer" },
    "strictness":{ "type": "integer", "description": "0 log, 1 standard, 2 assured, 3 regulated." },
    "minimum_tier": { "type": "string", "enum": ["open", "attested", "instrumented"],
                      "description": "Derived from the fields. A surface below this is refused before the job starts, never downgraded." },
    "disqualifiers": { "type": "array", "items": { "type": "string" } },
    "releases":      { "type": "array", "items": { "type": "string" } },
    "steps":     { "type": "array", "items": { "$ref": "step" } },
    "created_at":{ "type": "string" }
  },
  "required": ["id", "tenant_id", "key", "title", "version", "strictness", "minimum_tier", "steps", "created_at"]
}
