     "level": 0,
     "lineid": null,
     "text_raw": "'''Clear vegetation from the site.''' We used the OSE pulverizer on the Life Trac 6.",
     "text_rendered": "<strong>Clear vegetation from the site.</strong> We used the OSE pulverizer on the Life Trac 6."
    },
    {
     "bullet": "black",
     "bullet_style": {
