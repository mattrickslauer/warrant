     },
     "bullet_styleid": 1,
     "level": 0,
     "lineid": null,
     "text_raw": "'''You can strip off the topsoil, as well, or otherwise change the grade at this point.''' In our case, we had little topsoil and we liked the way the grade worked out by raising the building up on the gravel.",
     "text_rendered": "<strong>You can strip off the topsoil, as well, or otherwise change the grade at this point.</strong> In our case, we had little topsoil and we liked the way the grade worked out by raising the building up on the gravel."
    },
    {
     "bullet": "black",
     "bullet_style": {
      "bullet_color": "#11161a",
      "bullet_styleid": 1,
      "char": null,
      "color_locked": 1,
