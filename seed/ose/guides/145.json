 "introduction_json": {
  "content": [
   {
    "content": [
     {
      "text": "1. Sweep rocks and loose materials off the cement foundation",
      "type": "text"
     }
    ],
    "type": "paragraph"
   },
   {
    "content": [
     {
      "text": "2. Take sill seal foam gasket (2 rolls approx. 4in wide each) and set each roll side by side starting at one corner",
      "type": "text"
     }
    ],
    "type": "paragraph"
   },
   {
    "content": [
     {
      "text": "3. Place bricks or weighty material on top of the seal foam gaskets as you roll them out along the foundation",
      "type": "text"
     }
    ],
    "type": "paragraph"
   },
   {
    "content": [
     {
      "text": "4. Use a sharp knife to cut the material at the end of each corner and restart the above process along the next wall until complete the loop",
      "type": "text"
     }
    ],
    "type": "paragraph"
   },
   {
    "content": [
     {
      "text": "5. done!",
      "type": "text"
     }
    ],
    "type": "paragraph"
   }
  ],
  "type": "doc"
 },
 "introduction_raw": "1. Sweep rocks and loose materials off the cement foundation\n\n2. Take sill seal foam gasket (2 rolls approx. 4in wide each) and set each roll side by side starting at one corner\n\n3. Place bricks or weighty material on top of the seal foam gaskets as you roll them out along the foundation\n\n4. Use a sharp knife to cut the material at the end of each corner and restart the above process along the next wall until complete the loop\n\n5. done!",
 "introduction_rendered": "<p>1. Sweep rocks and loose materials off the cement foundation</p>\n\n<p>2. Take sill seal foam gasket (2 rolls approx. 4in wide each) and set each roll side by side starting at one corner</p>\n\n<p>3. Place bricks or weighty material on top of the seal foam gaskets as you roll them out along the foundation</p>\n\n<p>4. Use a sharp knife to cut the material at the end of each corner and restart the above process along the next wall until complete the loop</p>\n\n<p>5. done!</p>",
