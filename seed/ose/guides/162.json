 "introduction_json": {
  "content": [
   {
    "content": [
     {
      "text": "We are going to break down the framing into 11 framing modules that will be assembled on the ground in parallel with other construction processes.",
      "type": "text"
     }
    ],
    "type": "paragraph"
   },
   {
    "content": [
     {
      "text": "This is the how-to for the modules of the 2nd floor. Starting from the south, they are labeled 4-9 with an \"a\" and \"b\" distinction referencing their location on either west or east respectively.",
      "type": "text"
     }
    ],
    "type": "paragraph"
   }
  ],
  "type": "doc"
 },
