# Copy to .env and fill in. Nothing here is secret except the values you add.

# --- Google Cloud -----------------------------------------------------------
GCP_PROJECT=your-project-id
GCP_REGION=us-central1

# Model Armor templates must live in the `us` or `eu` MULTI-region for image
# modality. A template in us-central1 fails silently — see docs/architecture.md.
MODEL_ARMOR_LOCATION=us
MODEL_ARMOR_TEMPLATE=warrant-captures

# --- Models -----------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash

# Where the MODEL is served, which is NOT where the rest of the project runs. The Gemini 3
# family is published to the `global` endpoint; asking a regional host (us-central1) for it
# returns a flat 404 that reads exactly like a model that does not exist. Leave this alone
# unless you are pointing at a model that is genuinely regional.
GEMINI_LOCATION=global
# The screen runs on Flash-Lite, NOT on Gemma, and agents/warrant/screen.py explains why at
# length: this project cannot reach a Gemma publisher model — `models.list()` returns 23 models
# and not one of them is a Gemma — so asking for `gemma-3-4b` returns a flat 404 on every single
# capture, before the judge is ever reached. Setting it here anyway overrode the code's own
# working default with a name that cannot resolve. Point this at a full endpoint resource name
# if a Gemma is ever actually deployed; a bare publisher id has to be one that exists.
SCREENING_MODEL=gemini-3.5-flash-lite
IMAGE_MODEL=gemini-2.5-flash-image
EMBEDDING_MODEL=multimodalembedding

# --- Web --------------------------------------------------------------------
# Which DataSource the surfaces bind to. `fixture` needs no backend at all.
WARRANT_DATA_SOURCE=fixture
PORT=8080

# --- Identity and tenancy ---------------------------------------------------
# Sign in with Google, and the account decides the shape of the tenant: a Workspace domain
# is an enterprise, a consumer account is a tenant of one. See docs/architecture.md §7.
#
# These are PUBLIC. They ship to every browser and the API key is an identifier, not a
# secret — what protects the data is firestore.rules. Read them out of your own project:
#
#   gcloud firebase --help >/dev/null 2>&1   # (config lives in the Firebase API, not gcloud)
#   TOKEN=$(gcloud auth print-access-token)
#   curl -s "https://firebase.googleapis.com/v1beta1/projects/$GCP_PROJECT/webApps" \
#     -H "Authorization: Bearer $TOKEN" -H "x-goog-user-project: $GCP_PROJECT"
#   # then .../webApps/<appId>/config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The OAuth client Firebase created when Google sign-in was enabled. Optional: it tightens
# audience checking on Google's own ID token, which is where the `hd` claim comes from. The
# check that actually makes that token safe is the sub cross-check in google-hd.ts.
GOOGLE_OAUTH_CLIENT_ID=

# Sovereignty. Evidence and memory never leave the tenant's region.
WARRANT_REGION=us

# Exercise the Workspace branch from a consumer account. Writes a real `hd` custom claim by
# the same code path production uses, so firestore.rules sees a genuine Workspace user and
# nothing is special-cased. Refuses to work in a production build.
WARRANT_DEV_AUTH=0

# Which DataSource the BROWSER binds to. `fixture` needs no backend; `live` needs the config
# above and a signed-in user, because LiveSource reads through the authenticated client so
# that firestore.rules is what enforces tenancy.
NEXT_PUBLIC_WARRANT_DATA_SOURCE=fixture

# The canonical origin, which is where a link preview fetches its card image from. Leave it
# empty until the domain actually answers: web/src/app/layout.tsx then falls back to the Cloud
# Run hostname, and pinning a domain whose DNS and certificate are not live yet breaks every
# preview card silently — the image 404s against a host that is not serving. Read by Next at
# BUILD time, so infra/deploy-web.sh passes it as a --build-arg; setting it on a running
# revision does nothing.
NEXT_PUBLIC_SITE_URL=

# --- Workspace, tasks and instruments --------------------------------------------------
#
# All optional. Absent, the product runs exactly as before: tasks are still raised and still
# push, records still seal, and only the Workspace projection goes quiet.
#
# ONE GRANT, THREE APIS. A member connects Workspace once from /settings and Warrant gets
# calendar.events, gmail.compose and drive.file. Every one of those is a WRITE scope for a
# thing Warrant creates: it cannot read a calendar, cannot read a mailbox, and cannot see a
# file it did not make. See web/src/server/workspace.ts.

# The client SECRET matching GOOGLE_OAUTH_CLIENT_ID above. Needed only to exchange an
# authorisation code for a refresh token — sign-in itself does not use it.
# Never committed; on Cloud Run this belongs in Secret Manager, not an env file.
GOOGLE_OAUTH_CLIENT_SECRET=

# Where Google returns the technician after Workspace consent. Must match the redirect URI
# registered on the OAuth client exactly. Derived from the request when unset, which works
# locally and behind a single hostname.
#
# /api/auth/workspace/callback is the current path. /api/auth/calendar/callback is still
# served, so an OAuth client registered before the grant was widened keeps working — a
# redirect URI has to match the console character for character, and renaming a route is not
# a thing to discover during a demo.
GOOGLE_OAUTH_REDIRECT_URI=

# --- Notification email ------------------------------------------------------------------
#
# The mailbox Warrant sends task and record notifications FROM. Not a technician's: a person's
# grant is `gmail.compose`, which cannot send, and Warrant will not mail a foreman out of a
# mechanic's account. Both must be set or nothing is sent — `canSendMail()` reports that state
# rather than failing, because push and the calendar already reach people.
#
# Setting these needs a Workspace admin to authorise WARRANT_NOTIFIER_SA for
# https://www.googleapis.com/auth/gmail.send domain-wide, which is a deliberate act by the
# organisation being spoken for. Keyless: the token is minted through IAM Credentials signJwt,
# so there is no service-account private key anywhere in this repo or on the container.
#
# The DRAFTED PURCHASE ORDER needs none of this. It is written into a foreman's own drafts
# with their own grant, so it works on any deployment with an OAuth client and nothing else.
WARRANT_NOTIFIER_MAILBOX=
WARRANT_NOTIFIER_SA=

# Shared secret for POST /api/tasks/sweep, sent as `x-warrant-sweep`.
#
# In production Cloud Scheduler authenticates with an OIDC token and Cloud Run rejects
# unauthenticated callers before the handler runs, so this is a second lock. It is REQUIRED in
# a production build: unset, the route refuses every request rather than defaulting open.
WARRANT_SWEEP_SECRET=

# The instruments this deployment knows about: `tenant|toolId|secret`, comma separated.
#
#   WARRANT_INSTRUMENT_KEYS=acme.com|warrant-ref-01|<secret>,acme.com|torque-02|<secret>
#
# THE SECRET BELONGS TO THE DEVICE AND NOT TO THE APP. It is flashed into the instrument
# (firmware/warrant_reference_instrument.ino, TOOL_KEY) and never ships in the APK. The device
# signs each measurement with it; the handset relays a frame it cannot forge, and the server
# decodes the value from the signed bytes rather than believing the number the phone reported.
#
# THE TENANT IS NOT OPTIONAL, and it is first. `/api/ingest/reading` is the only writer of
# `readings`, and a reading with a tool_id is what lets the Seal call a field `measured` — so a
# registry that could not say which shop a device belongs to was a registry in which one key
# minted measured values in every shop. A Workspace tenant id is a domain name, so there was
# nothing to guess.
#
# The old single-value `WARRANT_INSTRUMENT_KEY` is deliberately NOT honoured: it named no tenant,
# so there was no safe way to read it. `parseRegistry` reports it rather than ignoring it.
#
# Unset, no reading can ever be attested and `measured` is simply unreachable. That is an honest
# state — the number still reaches the record, marked unattested — but it should be a state
# somebody chose, so infra/deploy-web.sh now says out loud when it is missing.
WARRANT_INSTRUMENT_KEYS=

# The deployed agent fleet. `infra/deploy-agents.py` prints this resource name on every
# deploy; the adjudicate route refuses to run without it rather than guessing.
WARRANT_FLEET_ENGINE=projects/…/locations/us-central1/reasoningEngines/…

# The principal allowed to call Vertex. LEAVE THIS UNSET LOCALLY — your ADC already has the
# access, and setting it makes every local run depend on an impersonation grant you do not
# need. Set it in Cloud Run, where the runtime identity is warrant-web, which deliberately
# cannot call Vertex itself.
WARRANT_ADJUDICATOR_SA=warrant-adjudicator@….iam.gserviceaccount.com
