# Copy to .env and fill in. Nothing here is secret except the values you add.

# --- Google Cloud -----------------------------------------------------------
GCP_PROJECT=your-project-id
GCP_REGION=us-central1

# Model Armor templates must live in the `us` or `eu` MULTI-region for image
# modality. A template in us-central1 fails silently — see docs/architecture.md.
MODEL_ARMOR_LOCATION=us
MODEL_ARMOR_TEMPLATE=warrant-captures

# --- Models -----------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash

# Where the MODEL is served, which is NOT where the rest of the project runs. The Gemini 3
# family is published to the `global` endpoint; asking a regional host (us-central1) for it
# returns a flat 404 that reads exactly like a model that does not exist. Leave this alone
# unless you are pointing at a model that is genuinely regional.
GEMINI_LOCATION=global
SCREENING_MODEL=gemma-3-4b
IMAGE_MODEL=gemini-2.5-flash-image
EMBEDDING_MODEL=multimodalembedding

# --- Web --------------------------------------------------------------------
# Which DataSource the surfaces bind to. `fixture` needs no backend at all.
WARRANT_DATA_SOURCE=fixture
PORT=8080

# --- Identity and tenancy ---------------------------------------------------
# Sign in with Google, and the account decides the shape of the tenant: a Workspace domain
# is an enterprise, a consumer account is a tenant of one. See docs/architecture.md §7.
#
# These are PUBLIC. They ship to every browser and the API key is an identifier, not a
# secret — what protects the data is firestore.rules. Read them out of your own project:
#
#   gcloud firebase --help >/dev/null 2>&1   # (config lives in the Firebase API, not gcloud)
#   TOKEN=$(gcloud auth print-access-token)
#   curl -s "https://firebase.googleapis.com/v1beta1/projects/$GCP_PROJECT/webApps" \
#     -H "Authorization: Bearer $TOKEN" -H "x-goog-user-project: $GCP_PROJECT"
#   # then .../webApps/<appId>/config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The OAuth client Firebase created when Google sign-in was enabled. Optional: it tightens
# audience checking on Google's own ID token, which is where the `hd` claim comes from. The
# check that actually makes that token safe is the sub cross-check in google-hd.ts.
GOOGLE_OAUTH_CLIENT_ID=

# Sovereignty. Evidence and memory never leave the tenant's region.
WARRANT_REGION=us

# Exercise the Workspace branch from a consumer account. Writes a real `hd` custom claim by
# the same code path production uses, so firestore.rules sees a genuine Workspace user and
# nothing is special-cased. Refuses to work in a production build.
WARRANT_DEV_AUTH=0

# Which DataSource the BROWSER binds to. `fixture` needs no backend; `live` needs the config
# above and a signed-in user, because LiveSource reads through the authenticated client so
# that firestore.rules is what enforces tenancy.
NEXT_PUBLIC_WARRANT_DATA_SOURCE=fixture

# --- Calendar, tasks and instruments --------------------------------------------------
#
# All optional. Absent, the product runs exactly as before: tasks are still raised and still
# push, records still seal, and only the calendar half goes quiet.

# The client SECRET matching GOOGLE_OAUTH_CLIENT_ID above. Needed only to exchange an
# authorisation code for a Calendar refresh token — sign-in itself does not use it.
# Never committed; on Cloud Run this belongs in Secret Manager, not an env file.
GOOGLE_OAUTH_CLIENT_SECRET=

# Where Google returns the technician after Calendar consent. Must match the redirect URI
# registered on the OAuth client exactly. Derived from the request when unset, which works
# locally and behind a single hostname.
GOOGLE_OAUTH_REDIRECT_URI=

# Shared secret for POST /api/tasks/sweep, sent as `x-warrant-sweep`.
#
# In production Cloud Scheduler authenticates with an OIDC token and Cloud Run rejects
# unauthenticated callers before the handler runs, so this is a second lock. It is REQUIRED in
# a production build: unset, the route refuses every request rather than defaulting open.
WARRANT_SWEEP_SECRET=

# The pairing secret a paired instrument presents to POST /api/ingest/reading, as
# `x-warrant-tool-key`, alongside its identity in `x-warrant-tool-id`.
#
# This endpoint is the ONLY writer of `readings`, and a reading with a tool_id is what lets the
# Seal call a field `measured`. Whoever holds this key can mint measured values, so it is the
# most sensitive value in this file. Unset, the endpoint refuses everything — which is the
# correct default, because a wide-open ingest is worse than no instrument path at all.
WARRANT_INSTRUMENT_KEY=
