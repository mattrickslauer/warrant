# Copy to .env and fill in. Nothing here is secret except the values you add.

# --- Google Cloud -----------------------------------------------------------
GCP_PROJECT=your-project-id
GCP_REGION=us-central1

# Model Armor templates must live in the `us` or `eu` MULTI-region for image
# modality. A template in us-central1 fails silently — see docs/architecture.md.
MODEL_ARMOR_LOCATION=us
MODEL_ARMOR_TEMPLATE=warrant-captures

# --- Models -----------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash
SCREENING_MODEL=gemma-3-4b
IMAGE_MODEL=gemini-2.5-flash-image
EMBEDDING_MODEL=multimodalembedding

# --- Web --------------------------------------------------------------------
# Which DataSource the surfaces bind to. `fixture` needs no backend at all.
WARRANT_DATA_SOURCE=fixture
PORT=8080

# --- Identity and tenancy ---------------------------------------------------
# Sign in with Google, and the account decides the shape of the tenant: a Workspace domain
# is an enterprise, a consumer account is a tenant of one. See docs/architecture.md §7.
#
# These are PUBLIC. They ship to every browser and the API key is an identifier, not a
# secret — what protects the data is firestore.rules. Read them out of your own project:
#
#   gcloud firebase --help >/dev/null 2>&1   # (config lives in the Firebase API, not gcloud)
#   TOKEN=$(gcloud auth print-access-token)
#   curl -s "https://firebase.googleapis.com/v1beta1/projects/$GCP_PROJECT/webApps" \
#     -H "Authorization: Bearer $TOKEN" -H "x-goog-user-project: $GCP_PROJECT"
#   # then .../webApps/<appId>/config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The OAuth client Firebase created when Google sign-in was enabled. Optional: it tightens
# audience checking on Google's own ID token, which is where the `hd` claim comes from. The
# check that actually makes that token safe is the sub cross-check in google-hd.ts.
GOOGLE_OAUTH_CLIENT_ID=

# Sovereignty. Evidence and memory never leave the tenant's region.
WARRANT_REGION=us

# Exercise the Workspace branch from a consumer account. Writes a real `hd` custom claim by
# the same code path production uses, so firestore.rules sees a genuine Workspace user and
# nothing is special-cased. Refuses to work in a production build.
WARRANT_DEV_AUTH=0

# Which DataSource the BROWSER binds to. `fixture` needs no backend; `live` needs the config
# above and a signed-in user, because LiveSource reads through the authenticated client so
# that firestore.rules is what enforces tenancy.
NEXT_PUBLIC_WARRANT_DATA_SOURCE=fixture
