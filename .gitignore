# Internal strategy — analyses the judging panel and the competitive field.
# If a judge reads this, it costs us the prize. Never commit it.
STRATEGY.md

# Environment and credentials
.env
.env.*
!.env.example
*-key.json
service-account*.json

# Python
__pycache__/
*.py[cod]
.venv/
.venv-deploy/
venv/
*.egg-info/

# Node
node_modules/

# Build and local
dist/
build/
.DS_Store
*.log

# Eval run output. The cassettes and the media corpus ARE committed — they are what makes
# the agent suite replayable with no cloud account — but a run's results are a moment in time.
agents/evals/runs/
__pycache__/
.pytest_cache/

# Transient deploy scratch — the Identity Platform config is fetched, merged, and deleted.
.warrant-idp-config.json
.warrant-domains.json

# The raw phone drop for the eval corpus. The photographs live resized and stripped under
# agents/evals/media/; the 149 MB original is an archive, not a repo artifact.
Warrant-training.zip

# Per-deployer, like .env. Not a secret — it ships inside every APK — but it pins the repo to
# one Firebase project, and this project keeps deployment config out of the tree. Fetch it:
#   ./infra/fetch-google-services.sh
android/app/google-services.json

# Worktrees this session created under the repo itself. The branches are the durable thing;
# the checkouts are scratch, and committing one would nest the whole tree inside itself.
.claude/worktrees/

# The anvil compiles itself on demand; the classes are not an artifact.
anvil/build/
