    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "22.10.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
